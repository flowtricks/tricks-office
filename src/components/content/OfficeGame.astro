---
import logoUrl from "@/assets/logo/logo.svg?url";

type Props = {
  /** Set to `false` to omit the component. */
  render?: boolean;
};
const { render = true } = Astro.props;
---

{
  render && (
    <section
      class="office-game_wrap"
      aria-label="The little office game"
      data-office
    >
      <div
        class="office-game_view"
        data-view
        tabindex="0"
        role="application"
        aria-label="Office. Use WASD or arrow keys to walk, Shift to run. Walk up to the desk to sit; press a direction again to stand up. Drag the character to pick him up and release to drop him. Drag the background to rotate the view."
        aria-describedby="office-controls"
      />
      <audio data-music src="/audio/music.mp3" loop preload="none" aria-hidden="true" />
      <header class="office-game_header">
        <a class="office-game_brand" href="/" aria-label="T.Ricks home">
          <img
            class="office-game_logo"
            src={logoUrl}
            alt="T.Ricks"
            width="1460"
            height="337"
          />
        </a>
        <div class="office-game_tools">
          <button
            class="office-game_icon office-game_sound"
            data-sound
            aria-label="Turn sound on"
            aria-pressed="false"
            title="Toggle sound"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <>
                <path d="M11 4 5 9H2v6h3l6 5V4Z" />
                <path data-sound-off d="m17 9 5 6m0-6-5 6" />
                <path
                  data-sound-on
                  d="M15 8c3 2 3 6 0 8m3-11c5 4 5 10 0 14"
                  style="display:none"
                />
              </>
            </svg>
          </button>
          <div
            class="office-game_views"
            data-views="close"
            role="group"
            aria-label="Camera view"
          >
            <button
              class="office-game_icon office-game_view-button"
              data-camera="wide"
              aria-label="Zoomed out view"
              aria-pressed="false"
              title="Zoomed out view"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                aria-hidden="true"
              >
                <path d="M3 9V3h6m6 0h6v6m0 6v6h-6m-6 0H3v-6" />
              </svg>
            </button>
            <button
              class="office-game_icon office-game_view-button"
              data-camera="close"
              aria-label="Zoomed in view"
              aria-pressed="true"
              title="Zoomed in view"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                aria-hidden="true"
              >
                <path d="M3 9h6V3m6 0v6h6m0 6h-6v6m-6 0v-6H3" />
              </svg>
            </button>
          </div>
        </div>
      </header>
      <div class="office-game_loading" data-loading role="status">
        <div class="office-game_loading-content">
          <h2 class="office-game_loading-title">Welcome to my office.</h2>
          <div class="office-game_loading-progress" role="progressbar" aria-label="Loading the office" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-load-progress><span data-load-bar /></div>
          <div class="office-game_loading-meta"><span data-load-label>Setting the scene…</span><span data-load-percent aria-hidden="true">0%</span></div>
        </div>
      </div>
      <div class="office-game_speech" data-speech data-visible="false" aria-hidden="true">
        <span class="office-game_speech-size" data-speech-size />
        <span class="office-game_speech-letters" data-speech-letters />
      </div>
      <span class="sr-only" data-speech-status role="status" aria-live="polite" />
      <button class="sr-only" data-echo-command>Ask Alexa to turn the lights off</button>
      <div class="office-game_touch" data-joystick aria-label="Drag to walk">
        <span data-thumb />
      </div>
      <footer class="office-game_footer">
        <div class="office-game_controls" id="office-controls">
          <>
            <span class="office-game_keys">
              <>
                <kbd>W</kbd>
                <span>
                  <>
                    <kbd>A</kbd>
                    <kbd>S</kbd>
                    <kbd>D</kbd>
                  </>
                </span>
              </>
            </span>
            <span>
              Move around
              <span class="office-game_secondary">Arrow keys also work</span>
            </span>
          </>
        </div>
      </footer>
      <span class="sr-only" data-desk-status role="status" />
      <div class="office-game_pause" data-pause hidden>
        <>
          <p>Paused</p>
          <button data-resume>
            Back to the office <span>↗</span>
          </button>
        </>
      </div>
      <noscript>
        <p class="office-game_loading">
          Enable JavaScript to explore the office.
        </p>
      </noscript>
    </section>
  )
}

<style is:global>
  @layer components {
    .office-game_wrap {
      --office-ink: #f5f5f5;
      --office-muted: #a3a3a3;
      --office-panel: #202020;
      position: relative;
      width: 100%;
      height: 100svh;
      min-height: 36rem;
      overflow: hidden;
      background: #090909;
      color: var(--office-ink);
      font-family: var(--primary-family);
      isolation: isolate;
    }
    .office-game_view {
      position: absolute;
      inset: 0;
      outline: none;
      touch-action: none;
      cursor: grab;
    }
    .office-game_view:active {
      cursor: grabbing;
    }
    .office-game_view canvas {
      display: block;
      width: 100%;
      height: 100%;
    }
    .office-game_wrap::after {
      content: "";
      position: absolute;
      inset: 0;
      pointer-events: none;
      box-shadow: inset 0 0 8rem #0003;
      z-index: 1;
    }
    .office-game_header {
      position: absolute;
      top: 0;
      inset-inline: 0;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 1.5rem;
      z-index: 3;
      pointer-events: none;
    }
    .office-game_brand {
      display: block;
      flex-shrink: 0;
      text-decoration: none;
      pointer-events: auto;
    }
    .office-game_logo {
      display: block;
      width: 5.4rem;
      height: auto;
    }
    .office-game_tools {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      pointer-events: auto;
    }
    .office-game_icon {
      color: #bfbfbf;
      width: 2.4rem;
      height: 2.4rem;
      border: 0;
      border-radius: 0.7rem;
      background: transparent;
      display: grid;
      place-items: center;
      cursor: pointer;
      transition:
        color 160ms,
        background 160ms;
    }
    .office-game_icon:hover {
      color: #fff;
    }
    .office-game_icon[aria-pressed="true"] {
      color: #fff;
    }
    .office-game_icon svg {
      width: 1rem;
      height: 1rem;
    }
    .office-game_sound {
      width: 2.8rem;
      height: 2.8rem;
      border-radius: 0.9rem;
      background: var(--office-panel);
    }
    .office-game_sound:hover {
      background: #303030;
    }
    .office-game_views {
      position: relative;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      padding: 0.2rem;
      border-radius: 0.9rem;
      background: var(--office-panel);
      isolation: isolate;
    }
    .office-game_views::before {
      content: "";
      position: absolute;
      top: 0.2rem;
      left: 0.2rem;
      width: calc((100% - 0.4rem) / 2);
      height: calc(100% - 0.4rem);
      border-radius: 0.7rem;
      background: #3a3a3a;
      transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
      pointer-events: none;
      z-index: -1;
      @media (prefers-reduced-motion: reduce) {
        transition: none;
      }
    }
    .office-game_views[data-views="close"]::before {
      transform: translateX(100%);
    }
    .office-game_footer {
      position: absolute;
      bottom: 0;
      inset-inline: 0;
      display: flex;
      align-items: end;
      justify-content: space-between;
      padding: 1.5rem;
      gap: 1rem;
      z-index: 3;
      pointer-events: none;
    }
    .office-game_controls {
      display: flex;
      align-items: center;
      gap: 0.8rem;
      padding: 0.75rem 1rem;
      background: var(--office-panel);
      border: 0;
      border-radius: 1rem;
      backdrop-filter: blur(1rem);
      font-size: 0.65rem;
      color: var(--office-ink);
    }
    .office-game_secondary {
      display: block;
      font-size: 0.55rem;
      color: var(--office-muted);
      margin-top: 0.2rem;
    }
    .office-game_keys {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.15rem;
    }
    .office-game_keys > span {
      display: flex;
      gap: 0.15rem;
    }
    .office-game_wrap kbd {
      font-family: inherit;
      display: inline-grid;
      place-items: center;
      border: 0;
      border-radius: 0.3rem;
      min-width: 1.15rem;
      height: 1.15rem;
      padding: 0 0.25rem;
      font-size: 0.5rem;
      color: #d4d4d4;
      background: #2a2a2a;
    }
    .office-game_speech {
      position: absolute;
      z-index: 4;
      pointer-events: none;
      padding: .95rem 1.35rem;
      border-radius: 1.35rem;
      background: linear-gradient(155deg, #fff, #f0f2f5);
      color: #262a31;
      font-size: clamp(.9rem, 2.3vw, 1.05rem);
      line-height: 1.45;
      font-weight: 500;
      letter-spacing: -.025em;
      white-space: nowrap;
      box-shadow: 0 .2rem .5rem #0000000d, 0 .8rem 2rem #00000024, inset 0 .0625rem 0 #fff;
      transform-origin: 50% 100%;
      transform: translate(-50%, calc(-100% + .5rem)) scale(.94);
      opacity: 0;
      visibility: hidden;
      transition: opacity .22s ease, transform .22s ease, visibility 0s linear .22s;
    }
    .office-game_speech[data-visible="true"] {
      opacity: 1;
      visibility: visible;
      transform: translate(-50%, -100%) scale(1);
      transition: opacity .25s ease, transform .38s cubic-bezier(.16, 1, .3, 1), visibility 0s;
    }
    .office-game_speech::after {
      content: "";
      position: absolute;
      bottom: -.36rem;
      left: calc(50% - .4rem);
      width: .8rem;
      height: .8rem;
      background: #f0f2f5;
      border-radius: 0 0 .2rem 0;
      transform: rotate(45deg);
    }
    .office-game_speech-size { visibility: hidden; }
    .office-game_speech-letters { position: absolute; inset: .95rem 1.35rem; }
    .office-game_speech-letters {
      opacity: 1;
      transform: translateY(0);
      transition: opacity .18s ease, transform .18s ease;
    }
    .office-game_speech:is([data-exit="text"], [data-exit="shrink"], [data-exit="fade"]) .office-game_speech-letters {
      opacity: 0;
      transform: translateY(-.25rem);
    }
    .office-game_speech[data-visible="true"]:is([data-exit="shrink"], [data-exit="fade"]) {
      transform: translate(-50%, -100%) scale(.88);
      transition: transform .22s cubic-bezier(.4, 0, .6, 1);
    }
    .office-game_speech[data-visible="true"][data-exit="fade"] {
      opacity: 0;
      transition: opacity .16s ease;
    }
    .office-game_speech[data-typing="true"] .office-game_speech-letters::after {
      content: "";
      display: inline-block;
      width: .1rem;
      height: .9em;
      margin-left: .15rem;
      border-radius: .1rem;
      background: #9ba2ad;
      vertical-align: -.08em;
    }
    @media (prefers-reduced-motion: reduce) {
      .office-game_speech, .office-game_speech[data-visible="true"],
      .office-game_speech[data-visible="true"][data-exit] { transition: none; transform: translate(-50%, -100%); }
      .office-game_speech .office-game_speech-letters { transition: none; transform: none; }
    }
    .office-game_loading {
      position: absolute;
      inset: 0;
      z-index: 5;
      background: radial-gradient(ellipse at 50% 45%, #202020, #0b0b0b 70%);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
      color: #b2b2b2;
      text-align: left;
      font-size: .8rem;
    }
    .office-game_loading-content {
      width: min(100%, 25rem);
      padding: clamp(1.75rem, 6vw, 2.75rem);
      border-radius: 2rem;
      background: linear-gradient(145deg, #222, #161616);
      box-shadow: 0 1.5rem 5rem #0005;
    }
    .office-game_loading-title { color: #fafafa; max-width: 12ch; font-size: clamp(1.9rem, 6vw, 2.55rem); font-weight: 500; letter-spacing: -.055em; line-height: 1.08; margin: 0 0 2.5rem; }
    .office-game_loading-progress { height: .3rem; background: #ffffff10; overflow: hidden; border-radius: 1rem; }
    .office-game_loading-progress span { display: block; height: 100%; width: 100%; background: #eee; border-radius: inherit; transform: scaleX(0); transform-origin: left; transition: transform .45s ease; }
    .office-game_loading-meta { display: flex; justify-content: space-between; gap: 1rem; margin-top: .8rem; color: #b6b6b6; font-size: .65rem; font-variant-numeric: tabular-nums; }

    @media (prefers-reduced-motion: reduce) {
      .office-game_loading-progress span { transition: none; }
    }
    .office-game_touch {
      display: none;
    }
    .office-game_pause {
      position: absolute;
      inset: 0;
      z-index: 7;
      background: #0a0a0ac9;
      backdrop-filter: blur(0.6rem);
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
    }
    .office-game_pause p {
      font-family: inherit;
      font-size: 2rem;
      font-weight: 600;
      letter-spacing: -0.05em;
      color: var(--office-ink);
      margin: 0 0 1.25rem;
    }
    .office-game_pause button {
      padding: 0.8rem 1.2rem;
      border: 0;
      border-radius: 0.8rem;
      background: #f5f5f5;
      color: #171717;
      font-family: inherit;
      font-weight: 500;
      font-size: 0.7rem;
      cursor: pointer;
    }
    .office-game_pause button:hover {
      background: #d4d4d4;
    }
    .office-game_pause button span {
      margin-left: 1rem;
    }
    .office-game_wrap [hidden] {
      display: none;
    }
    .office-game_wrap button:focus-visible,
    .office-game_brand:focus-visible {
      outline: 0.125rem solid #fff;
      outline-offset: 0.2rem;
    }
    .office-game_wrap {
      @media (width < 48rem) {
        min-height: 32rem;
        .office-game_header {
          padding: 1rem;
          gap: 0.5rem;
        }
        .office-game_logo {
          width: 5rem;
        }
        .office-game_footer {
          padding: 1rem;
        }
        .office-game_controls {
          display: none;
        }
        .office-game_touch {
          display: grid;
          place-items: center;
          position: absolute;
          bottom: 1rem;
          left: 1rem;
          z-index: 4;
          width: 4.5rem;
          height: 4.5rem;
          background: var(--office-panel);
          border: 0;
          border-radius: 50%;
          backdrop-filter: blur(0.5rem);
          touch-action: none;
        }
        .office-game_touch span {
          width: 2rem;
          height: 2rem;
          background: #fff;
          border: 0;

          border-radius: 50%;
          pointer-events: none;
        }
      }
    }
  }
</style>

<script>
  import {
    createCharacterAnimator,
    createWalkCycle,
    WALK_SPEED,
  } from "@/scripts/character-animation";
  import { createFootContacts, createFootstepAudio, createAlexaReplyAudio, createShelfHoverAudio, createCharacterLiftAudio, createObjectPressAudio, createShelfTransitionAudio, createTypingAudio, createDeskAudio } from "@/scripts/office-audio";
  import { createOfficeFrameBudget } from "@/scripts/office-frame-budget";
  import { isAppleTouchDevice, officePixelRatio, officeRenderSupport } from "@/scripts/office-render-support";
  import { prepareOfficeChair } from "@/scripts/office-chair";
  import {
    clearsOfficeChair,
    createOfficeSeating,
  } from "@/scripts/office-seating";
  import { createChairAvoidance } from "@/scripts/office-chair-avoidance";
  import { createOfficeWalking } from "@/scripts/office-walking";
  import { findOfficeRoute } from "@/scripts/office-navigation";
  import {
    createOfficeBotanicals,
    createReferenceShelfLamp,
  } from "@/scripts/office-botanicals";
  import { createStudioLight } from "@/scripts/studio-light";
  import {
    createWaterValvePanel,
    roundedPanelPath,
  } from "@/scripts/water-valve-panel";
  import {
    createElgatoArm,
    createShureSM7B,
    createOpalC1,
  } from "@/scripts/desk-equipment";
  import { nearestLanding } from "@/scripts/office-landing";
  import { batchRigidMeshes, accelerateOfficePicking } from "@/scripts/office-render-optimization";
  import { createEchoDot, createRoomLightSwitch, createEchoCommand } from "@/scripts/office-echo";
  import { createWindowLandscape } from "@/scripts/window-landscape";
  import { prepareCharacter } from "@/scripts/character-materials";
  import {
    createWebflowAward,
    createModernWebflowAwards,
  } from "@/scripts/office-award";
  import { createLeafMotion } from "@/scripts/office-leaf-motion";
  import {
    createShelfFocusTargets,
    shelfFocusDistance,
    type ShelfFocusTarget,
  } from "@/scripts/office-shelf-focus";
  import * as T from "three";
  import shelfMarkSvg from "@/assets/logo/shelf-mark.svg?raw";
  import { SVGLoader } from "three/addons/loaders/SVGLoader.js";
  import { GLTFLoader } from "three/addons/loaders/GLTFLoader.js";
  import { MeshoptDecoder } from "three/addons/libs/meshopt_decoder.module.js";
  import { RoundedBoxGeometry } from "three/addons/geometries/RoundedBoxGeometry.js";
  import { EffectComposer } from "three/addons/postprocessing/EffectComposer.js";
  import { RenderPass } from "three/addons/postprocessing/RenderPass.js";
  import { GTAOPass } from "three/addons/postprocessing/GTAOPass.js";
  import { UnrealBloomPass } from "three/addons/postprocessing/UnrealBloomPass.js";
  import { OutputPass } from "three/addons/postprocessing/OutputPass.js";
  import { SMAAPass } from "three/addons/postprocessing/SMAAPass.js";
  import { RectAreaLightUniformsLib } from "three/addons/lights/RectAreaLightUniformsLib.js";
  import { RoomEnvironment } from "three/addons/environments/RoomEnvironment.js";
  import { mergeGeometries } from "three/addons/utils/BufferGeometryUtils.js";

  const root = document.querySelector<HTMLElement>("[data-office]");
  if (root)
    void mountOffice(root).catch((error) => {
      console.error("Office could not start", error);
      const loading = root.querySelector<HTMLElement>("[data-loading]");
      if (loading) {
        loading.hidden = false;
        loading.textContent =
          "The office could not load. Please reload to try again.";
      }
    });

  async function mountOffice(root: HTMLElement) {
    const get = <E extends HTMLElement = HTMLElement>(selector: string) =>
      root.querySelector<E>(selector)!;
    const view = get("[data-view]");
    const music = get<HTMLAudioElement>("[data-music]");
    const loading = get("[data-loading]");
    const loadingBar = get("[data-load-bar]");
    const loadingLabel = get("[data-load-label]");
    const loadingPercent = get("[data-load-percent]");
    const loadingProgress = get("[data-load-progress]");
    function setLoadingProgress(value: number, label: string) {
      loadingBar.style.transform = `scaleX(${value / 100})`;
      loadingPercent.textContent = `${value}%`;
      loadingProgress.setAttribute("aria-valuenow", String(value));
      loadingLabel.textContent = label;
    }
    let loadedAssets = 0;
    const trackAsset = async <Value,>(asset: Promise<Value>) => {
      const value = await asset;
      loadedAssets++;
      setLoadingProgress(Math.round(loadedAssets / 7 * 85), loadedAssets < 4 ? "Setting the scene…" : "Arranging the details…");
      return value;
    };
    const loader = new GLTFLoader().setMeshoptDecoder(MeshoptDecoder);
    const [
      model,
      studioStand,
      macbook,
      lumi,
      officeChair,
      botanicals,
      modernAwards,
    ] = await Promise.all([
      trackAsset(loader.loadAsync("/models/reference-character.glb")),
      trackAsset(loader.loadAsync("/models/studio-light-stand.glb")),
      trackAsset(loader.loadAsync("/models/macbook-pro-14-m5.glb")),
      trackAsset(loader.loadAsync("/models/lumi-shelf.glb")),
      trackAsset(loader.loadAsync("/models/office-chair.glb")),
      trackAsset(createOfficeBotanicals()),
      trackAsset(createModernWebflowAwards()),
    ]);
    setLoadingProgress(90, "Turning on the lights…");
    await new Promise<void>(resolve => requestAnimationFrame(() => resolve()));
    const abort = new AbortController();
    const signal = abort.signal;
    const compact = matchMedia("(max-width: 48rem)").matches;
    const reduced = matchMedia("(prefers-reduced-motion: reduce)");
    const appleTouch = isAppleTouchDevice(navigator.userAgent, navigator.maxTouchPoints);
    const frameBudget = createOfficeFrameBudget(appleTouch);
    let renderer: T.WebGLRenderer;
    try {
      renderer = new T.WebGLRenderer({
        // The composer provides MSAA/SMAA; a second MSAA backbuffer wastes GPU memory.
        antialias: false,
        powerPreference: "high-performance",
      });
    } catch {
      loading.textContent =
        "This little office needs WebGL. Try opening it in a browser with hardware acceleration.";
      return;
    }
    renderer.setPixelRatio(officePixelRatio(view.clientWidth, view.clientHeight, devicePixelRatio, appleTouch));
    renderer.shadowMap.enabled = true;
    // The beauty and AO passes share the same shadow maps within each frame.
    renderer.shadowMap.autoUpdate = false;
    renderer.shadowMap.type = T.PCFShadowMap;
    renderer.toneMapping = T.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.0;
    renderer.domElement.setAttribute("aria-hidden", "true");
    view.append(renderer.domElement);
    const scene = new T.Scene();
    scene.background = new T.Color("#090909");
    scene.fog = new T.FogExp2("#090909", 0.018);
    const camera = new T.PerspectiveCamera(36, 1, 0.1, 80);
    const pmrem = new T.PMREMGenerator(renderer);
    const environment = new RoomEnvironment();
    let environmentTarget = pmrem.fromScene(environment, 0.04);
    scene.environment = environmentTarget.texture;
    scene.environmentIntensity = 0.25;
    environment.dispose();
    pmrem.dispose();
    const world = new T.Group();
    const leftWall = new T.Group();
    const backWall = new T.Group();
    scene.add(world, leftWall, backWall);
    let seed = 43;
    function random() {
      seed = (seed * 1664525 + 1013904223) >>> 0;
      return seed / 4294967296;
    }
    function texture(kind: "wood" | "fabric" | "hair") {
      const canvas = document.createElement("canvas");
      const size = kind === "wood" ? 1024 : 256;
      canvas.width = canvas.height = size;
      const ctx = canvas.getContext("2d")!;
      ctx.fillStyle = kind === "wood" ? "#bba17b" : "#b3aaa1";
      ctx.fillRect(0, 0, size, size);
      for (let i = 0; i < (kind === "wood" ? 12000 : 12000); i++) {
