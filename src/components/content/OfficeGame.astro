          if (walkable(x, z)) {
            character.position[axis] += amount;
            if (axis === "x") movedX = amount;
            else movedZ = amount;
            moved += amount * amount;
          }
        }
        moved = Math.sqrt(moved);
        if (!chairMotion.active && !airborne) {
          character.rotation.y = walking.face(character.rotation.y, movedX, movedZ, dt);
        }
        const gait = walkCycle.update(
          (chairMotion.active ? chairMotion.distance : moved) / characterScale,
          dt,
          chairMotion.active ? chairMotion.walking : input.lengthSq() > 0.0001,
        );
        const contacts = footContacts(gait.phase, gait.stride,
          !carrying && !falling && !reduced.matches && (!chairMotion.pose || chairMotion.pose.sit < .05));
        if (sound) for (let i = 0; i < contacts; i++) footsteps?.play();
        characterAnimator.update({
          time,
          ...gait,
          suspended: carrying
            ? 1
            : falling
              ? T.MathUtils.smoothstep(character.position.y, 0.25, 0.8)
              : 0,
          landingCompression: carrying || falling ? 0 : landingCompression,
          hangPitch: hangSway.x,
          hangRoll: hangSway.y,
          reduced: reduced.matches,
          chairPose: chairMotion.pose ? {
            ...chairMotion.pose,
            seatHeight: chairMotion.pose.seatHeight / characterScale,
            footForward: chairMotion.pose.footForward / characterScale,
            footLift: chairMotion.pose.footLift / characterScale,
          } : undefined,
        });
      }
      updateCamera(dt);
      updateWallCutaway();
      if (hoverPointer && pointerId === undefined && !paused && !inspectedShelf) {
        aimPointer(hoverPointer);
        hoverPointer = undefined;
        const hovered = pickShelfObject();
        if (shelfPicking.setHovered(hovered) && sound) shelfHoverAudio?.play();
        const overEcho = !hovered && pickEcho();
        if (overEcho && !echoHovered && sound) shelfHoverAudio?.play();
        echoHovered = !!overEcho;
        const cursor = hovered ? "zoom-in" : pickDeskButton() || overEcho || pickSeat() ? "pointer" : "";
        if (view.style.cursor !== cursor) view.style.cursor = cursor;
      }
      shelfPicking.update(dt, reduced.matches, staticLeftWall.visible);
      const echoHoverGoal = echoHovered && !paused && !inspectedShelf ? 1 : 0;
      echoHoverAmount = T.MathUtils.lerp(echoHoverAmount, echoHoverGoal, 1 - Math.exp(-dt * (echoHoverGoal ? 12 : 8)));
      echo.position.y = reduced.matches ? 0 : echoHoverAmount * .035;
      leafMotion.update(dt, !paused && !reduced.matches && !dragging);
      windowWalkTarget.set(0, 0, 0);
      if (!wideView && !inspectedShelf && !reduced.matches) {
        windowWalkTarget.set(character.position.x + 1.55, 0, character.position.z + 0.8).multiplyScalar(1.5);
      }
      windowWalkParallax.lerp(windowWalkTarget, 1 - Math.exp(-dt * 6));
      windowGroup.worldToLocal(windowEye.copy(camera.position).add(windowWalkParallax));
      windowEye.z -= 0.012;
      windowLandscape.updateView(
        windowEye,
        windowOpening.width,
        windowOpening.height,
      );
      const command = echoCommand.update(paused ? 0 : dt);
      if (sound) for (let i = 0; i < command.typedLetters; i++) typingAudio?.play();
      if (command.finishedTyping && sound) alexaReply?.play();
      if (command.changed) {
        roomLighting.set(command.on);
        echoButton.textContent = `Ask Alexa to turn the lights ${command.on ? "off" : "on"}`;
      }
      roomLighting.update(paused ? 0 : dt);
      if (command.visible && speechLetters.textContent !== command.text) speechLetters.textContent = command.text;
      if (speech.dataset.exit !== command.exit) speech.dataset.exit = command.exit;
      const typing = String(command.visible && command.exit === "none" && command.text.length < (speechSize.textContent?.length ?? 0));
      if (speech.dataset.typing !== typing) speech.dataset.typing = typing;
      if (command.visible) {
        head.getWorldPosition(speechAnchor);
        speechAnchor.y += .9 * characterScale;
        speechAnchor.project(camera);
      }
      const speechVisible = command.visible && speechAnchor.z <= 1 && speechAnchor.z >= -1;
      if (speech.dataset.visible !== String(speechVisible)) speech.dataset.visible = String(speechVisible);
      if (speechVisible) {
        const width = view.clientWidth, height = view.clientHeight;
        const half = speech.offsetWidth / 2 + 12;
        speech.style.left = `${T.MathUtils.clamp((speechAnchor.x * .5 + .5) * width, half, width - half) / width * 100}%`;
        speech.style.top = `${T.MathUtils.clamp((-.5 * speechAnchor.y + .5) * height - 12, speech.offsetHeight + 16, height - 24) / height * 100}%`;
      }
      renderer.shadowMap.needsUpdate = frameBudget.shadowsDue(now);
      composer.render();

    }
    function dispose() {
      if (disposed) return;
      disposed = true;
      abort.abort();
      cancelAnimationFrame(frame);
      resizeObserver.disconnect();
      pauseMusic();
      music.removeAttribute("src");
      music.load();
      void audio?.close();
      const geometries = new Set<T.BufferGeometry>(),
        materials = new Set<T.Material>(),
        textures = new Set<T.Texture>();
      scene.traverse((o) => {
        if (o instanceof T.Mesh) {
          geometries.add(o.geometry);
          (Array.isArray(o.material) ? o.material : [o.material]).forEach((m) =>
            materials.add(m),
          );
        }
      });
      materials.forEach((m) => {
        Object.values(m).forEach((v) => {
          if (v instanceof T.Texture) textures.add(v);
        });
        m.dispose();
      });
      textures.forEach((t) => t.dispose());
      geometries.forEach((g) => g.dispose());
      environmentTarget.dispose();
      composer.passes.forEach((p) => p.dispose());
      composer.dispose();
      renderer.dispose();
      renderer.domElement.remove();
    }
    document.addEventListener("astro:before-swap", dispose, {
      once: true,
      signal,
    });
    window.addEventListener(
      "pagehide",
      (e) => {
        if (!e.persisted) dispose();
      },
      { signal },
    );
    await windowLandscape.ready;
    await renderer.compileAsync(scene, camera);
    if (disposed) return;
    if (import.meta.env.DEV && new URLSearchParams(location.search).has("export-branding")) {
      const { addBrandingExports } = await import("../../../scripts/export-office-branding");
      addBrandingExports(scene, camera, renderer, composer);
    }
    // Compile/render the post-processing chain too before removing the loader.
    // Scene-only compileAsync does not validate its offscreen framebuffers.
    renderer.shadowMap.needsUpdate = true;
    composer.render();
    const gl = renderer.getContext();
    if (contextLost || gl.isContextLost()) return;
    if (gl.getError() !== gl.NO_ERROR) {
      // Retry without multisample resolves, retaining bloom, tone mapping and SMAA.
      composer.renderTarget1.samples = composer.renderTarget2.samples = 0;
      composer.renderTarget1.dispose();
      composer.renderTarget2.dispose();
      for (let i = 0; i < 16 && gl.getError() !== gl.NO_ERROR; i++) { /* drain startup errors */ }
      composer.render();
      if (gl.getError() !== gl.NO_ERROR) {
        throw new Error("The graphics pipeline could not render its first frame.");
      }
    }
    setLoadingProgress(100, "Welcome in.");
    frame = requestAnimationFrame(animate);
    const reveal = loading.animate([{ opacity: 1 }, { opacity: 0 }], { duration: reduced.matches ? 0 : 400, easing: "ease-out" });
    void reveal.finished.then(() => { loading.hidden = true; }).catch(() => {});
  }
</script>
